{
  "name": "tennis-progress",
  "version": "1.0.0",
  "private": true,
  "description": "Family-first tennis development platform: 200-drill library, 10-session planner, KPI engine, parent view.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --serve",
    "build": "node scripts/build.mjs",
    "build:single": "node scripts/build.mjs --single",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && tsx scripts/quality.ts",
    "test:e2e": "npm run build:single && node e2e/e2e.mjs all && node e2e/shared.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0 || ^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}