# Optional. When both are set at build time, the app requires sign-in and stores each
# user's workspace in Supabase (see supabase/schema.sql). When empty, the app runs in
# demo mode with storage in the browser only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
